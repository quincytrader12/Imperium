__pycache__/
*.py[cod]
.venv/
.pytest_cache/
build/
dist/
# PyInstaller writes a generated <name>.spec into the working directory. Ignore
# those, but ONLY at the repo root -- a bare "*.spec" also excluded the
# hand-written packaging/godalgo.spec, so the build worked locally and CI failed
# with "Spec file not found" for a file that had never been committed.
/*.spec
.godalgo/
